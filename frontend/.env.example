# Copy to .env (all optional).

# Call a backend on another host. Leave empty when safety_server.py serves this app,
# or when using `npm run dev` (Vite proxies /path and /api to http://127.0.0.1:8000).
VITE_API_URL=

# 1 = use src/mock/mock_path.json instead of the backend.
VITE_USE_MOCK=

# simulate (default) replays the walk with a "step off the path" demo button;
# gps uses the phone's real location (needs HTTPS on a phone).
VITE_TRACKING_MODE=simulate
